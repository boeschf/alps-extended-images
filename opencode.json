{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "cscs": {
      "npm": "@ai-sdk/anthropic",
      "name": "CSCS Inference",
      "options": {
        "baseURL": "https://api.inference.cscs.ch/v1",
        "apiKey": "{env:CSCS_INFERENCE_API_KEY}",
        "systemMessageMode": "system"
      },
      "models": {
        "zai-org/GLM-5.2": {
          "name": "GLM-5.2 [CSCS]",
          "tool_call": true,
          "modalities": { "input": ["text"], "output": ["text"] },
          "limit": { "context": 976000, "output": 32768 }
        },
        "zai-org/GLM-5.3": {
          "name": "GLM-5.3 [CSCS]",
          "tool_call": true,
          "modalities": { "input": ["text"], "output": ["text"] },
          "limit": { "context": 1048576, "output": 32768 }
        },
        "moonshotai/Kimi-K2.7-Code": {
          "name": "Kimi-K2.7-Code [CSCS]",
          "tool_call": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 262144, "output": 32768 }
        }
      }
    }
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "allow"
    },
    "bash": "allow",
    "edit": "deny",
    "write": "deny",
    "webfetch": "allow"
  },
  "instructions": ["CONTRIBUTING.md","AGENTS.md"],
  "model": "cscs/moonshotai/Kimi-K2.7-Code",
  "small_model": "cscs/moonshotai/Kimi-K2.7-Code",
  "share": "disabled",
  "default_agent": "grumpy-reviewer"
}